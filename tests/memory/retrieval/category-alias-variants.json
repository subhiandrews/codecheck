    {"name": "upper-case", "mode": "findings", "findings": [{"file": "pkg/parser/lexer.py", "category": "Test-Coverage"}], "expect": ["parser-tests"]},
    {"name": "testing", "mode": "findings", "findings": [{"file": "pkg/parser/ast.py", "category": "testing"}], "expect": ["parser-tests"]},
    {"name": "unrelated-category", "mode": "findings", "findings": [{"file": "pkg/parser/lexer.py", "category": "naming"}], "expect_absent": ["parser-tests"]}
